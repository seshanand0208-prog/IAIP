#include <WiFi.h>
#include <HTTPClient.h>
#include <SPI.h>
#include <MFRC522.h>
#include <Wire.h>
#include <LiquidCrystal_I2C.h>

#define SS_PIN 5
#define RST_PIN 27
#define BUZZER 4

#define GREEN_LED 2
#define RED_LED 15

MFRC522 mfrc522(SS_PIN, RST_PIN);
LiquidCrystal_I2C lcd(0x27, 16, 2);

// WiFi
const char* ssid = "Dianosour mutta";
const char* password = "snyderverse";

// Google Script
String serverName = "https://script.google.com/macros/s/AKfycbyO1bxNRF-WCUstFvjdVMD57Ips1N1hJ66-YvH_7fqeO3mw-hVNRpXj_clnIlLOS53c/exec";

// UID database
String uid1 = "40CA5B53";
String name1 = "SESHANAND S";

String uid2 = "A1DFDC0A";
String name2 = "ANAND";

void setup() {
  Serial.begin(115200);

  pinMode(BUZZER, OUTPUT);
  digitalWrite(BUZZER, LOW);

  pinMode(GREEN_LED, OUTPUT);
  pinMode(RED_LED, OUTPUT);

  // 🔴 Default state = RED ON
  digitalWrite(RED_LED, HIGH);
  digitalWrite(GREEN_LED, LOW);

  lcd.init();
  lcd.backlight();

  lcd.setCursor(0,0);
  lcd.print("Smart Attendance");
  lcd.setCursor(0,1);
  lcd.print("Starting...");

  WiFi.begin(ssid, password);

  while (WiFi.status() != WL_CONNECTED) {
    delay(500);
    Serial.print(".");
  }

  lcd.clear();
  lcd.print("WiFi Connected");

  SPI.begin(18, 19, 23, SS_PIN);
  mfrc522.PCD_Init();

  delay(1000);
  lcd.clear();
  lcd.print("Scan RFID");
}

// CLEAN UID FUNCTION
String getUID() {
  String uid = "";

  for (byte i = 0; i < mfrc522.uid.size; i++) {
    if (mfrc522.uid.uidByte[i] < 0x10) uid += "0";
    uid += String(mfrc522.uid.uidByte[i], HEX);
  }

  uid.toUpperCase();
  return uid;
}

// SEND TO SHEET
void sendToSheet(String name, String status) {
  if (WiFi.status() == WL_CONNECTED) {
    HTTPClient http;

    String url = serverName +
      "?name=" + name +
      "&roll=21CS001&year=2nd&dept=ECE&status=" + status;

    http.begin(url);
    int code = http.GET();

    Serial.print("Response: ");
    Serial.println(code);

    http.end();
  }
}

void loop() {

  if (!mfrc522.PICC_IsNewCardPresent()) return;
  if (!mfrc522.PICC_ReadCardSerial()) return;

  String uid = getUID();
  Serial.println("UID: " + uid);

  String name = "Unknown";
  String status = "Access Denied";

  lcd.clear();
  lcd.setCursor(0,0);
  lcd.print("Scanning...");

  // 🟢 RFID SCANNED → GREEN ON, RED OFF
  digitalWrite(RED_LED, LOW);
  digitalWrite(GREEN_LED, HIGH);

  delay(500);

  // MATCH
  if (uid == uid1) {
    name = name1;
    status = "Present";
  }
  else if (uid == uid2) {
    name = name2;
    status = "Present";
  }

  lcd.clear();
  lcd.setCursor(0,0);
  lcd.print(status);
  lcd.setCursor(0,1);
  lcd.print(name);

  // BUZZER (UNCHANGED)
  if (status == "Present") {
    digitalWrite(BUZZER, HIGH);
    delay(5000);
    digitalWrite(BUZZER, LOW);
  } else {
    for (int i = 0; i < 3; i++) {
      digitalWrite(BUZZER, HIGH);
      delay(150);
      digitalWrite(BUZZER, LOW);
      delay(150);
    }
  }

  sendToSheet(name, status);

  delay(2000);

  // 🔴 BACK TO IDLE STATE
  digitalWrite(GREEN_LED, LOW);
  digitalWrite(RED_LED, HIGH);

  lcd.clear();
  lcd.print("Scan RFID");
}
